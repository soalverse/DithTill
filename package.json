{
  "name": "dithtill",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "Turn your photos, videos, drawings and songs into 1-bit dithered and halftone art that moves to the music, free and open source, so go build something strange.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "verify:fast": "npm run typecheck && npm run test",
    "verify:precommit": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "install-hooks": "node scripts/install-hooks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "verify:video": "cargo test --release --manifest-path src-tauri/codec/Cargo.toml",
    "fetch-bg-model": "node scripts/fetch-bg-model.mjs",
    "build:codec": "node scripts/build-codec-wasm.mjs",
    "check-bundled-assets": "node scripts/check-bundled-assets.mjs",
    "notices": "node scripts/gen-third-party-notices.mjs"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-log": "^2.8.0",
    "immer": "^11.1.8",
    "konva": "10.3.0",
    "onnxruntime-web": "^1.27.0",
    "pako": "^3.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-konva": "19.2.5",
    "upng-js": "^2.1.0",
    "zundo": "2.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tauri-apps/cli": "^2.11.3",
    "@types/node": "^26.0.1",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "playwright-core": "^1.61.1",
    "prettier": "^3.8.4",
    "sharp": "^0.35.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.9",
    "zod": "^4.4.3"
  }
}
