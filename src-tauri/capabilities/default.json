{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the DithTill window may touch on your computer: the files you pick in a dialog, its own cache, and the Library inbox. It may also ask whether a file name is taken, but it may not look inside. We try not to sneak.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "log:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:default",
    { "identifier": "fs:allow-mkdir", "allow": [{ "path": "$APPCACHE/**" }] },
    { "identifier": "fs:allow-read-dir", "allow": [{ "path": "$APPCACHE/**" }] },
    { "identifier": "fs:allow-read-file", "allow": [{ "path": "$APPCACHE/**" }] },
    { "identifier": "fs:allow-write-file", "allow": [{ "path": "$APPCACHE/**" }] },
    { "identifier": "fs:allow-remove", "allow": [{ "path": "$APPCACHE/**" }] },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/library-inbox" }, { "path": "$APPDATA/library-inbox/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$APPDATA/library-inbox" }, { "path": "$APPDATA/library-inbox/**" }]
    },
    { "identifier": "fs:allow-read-file", "allow": [{ "path": "$APPDATA/library-inbox/**" }] },
    { "identifier": "fs:allow-rename", "allow": [{ "path": "$APPDATA/library-inbox/**" }] },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$HOME/**" }, { "path": "**" }]
    }
  ]
}
