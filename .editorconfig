root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 reads .ps1 as ANSI; keep them ASCII/latin1, not UTF-8.
[*.ps1]
charset = latin1
end_of_line = crlf
